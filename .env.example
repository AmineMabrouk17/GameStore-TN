# Public site config
NEXT_PUBLIC_SELLER_PHONE="+216XXXXXXXX"
NEXT_PUBLIC_WHATSAPP_NUMBER="216XXXXXXXX"

# ADMIN_JWT_SECRET — HS256 signing key for admin session JWTs (lib/auth/session.ts).
# Use a long random string (>= 32 chars); generate one with: openssl rand -base64 48
# Dev: copy this file to .env.local (next dev) and/or .dev.vars (wrangler dev).
# Prod: npx wrangler secret put ADMIN_JWT_SECRET
# Login brute-force protection is expected at the edge/WAF level (Cloudflare), not in-app.
ADMIN_JWT_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"
