{
  "name": "gamestore-tn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gen-Z gaming accounts marketplace for Tunisia - PES/eFootball, Free Fire & more. Next.js + Cloudflare D1.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:schema:local": "wrangler d1 execute gamestore_db --local --file=./schema.sql",
    "db:seed:local": "wrangler d1 execute gamestore_db --local --file=./seed.sql",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.1",
    "geist": "^1.7.2",
    "jose": "^6.2.10",
    "lucide-react": "^1.33.0",
    "next": "15.5.23",
    "next-intl": "^4.13.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.0",
    "eslint-config-next": "15.5.23",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  }
}
